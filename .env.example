# Copy this file to .env and fill in your own values.
# .env is listed in .gitignore and must never be committed.

# Neon: `npx neon@latest deploy` writes these for you, or copy them from
# your project → Connect. The pooled URL is for the app, the direct
# (unpooled) one for schema changes.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DATABASE?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# OpenRouter: Settings → API Keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=provider/model-name

# Only used by the seed script on your own computer, never on Vercel
ADMIN_USERNAME=your-username
ADMIN_PASSWORD=a-long-strong-password
